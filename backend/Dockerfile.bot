
FROM python:3.11-alpine

# The unversioned postgresql-client tracks Alpine's newest (18.x) against a
# PostgreSQL 15 server, which is unsupported and already produced
# "unrecognized configuration parameter" during a restore drill. This image
# only carries postgresql16-client, so pin that: 16 is still ahead of the
# server, but one minor version rather than three, and it is the closest
# available. Alpine no longer packages a 15 client.
#
# The correct long-term fix is to move the server to a supported pairing —
# either upgrade Postgres or build the bot on an image that has a 15 client.
RUN apk add --no-cache postgresql16-client bash gzip

# Without this Python buffers stdout and the container produces NO logs at all.
# The bot ran for hours with an empty log, which made it impossible to diagnose.
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY scripts/requirements-bot.txt .
RUN pip install --no-cache-dir -r requirements-bot.txt

COPY scripts/backup_bot.py .

CMD ["python", "backup_bot.py"]
