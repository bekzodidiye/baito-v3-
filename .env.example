# Copy to .env and fill in real values. Nothing here has a working default:
# docker-compose refuses to start if a required secret is missing.

# ─── Runtime ────────────────────────────────────────────────────────────────
# "production" turns on Secure/SameSite=strict cookies and HSTS, and hides
# /docs and the OpenAPI schema.
ENVIRONMENT=production

# ─── Secrets ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

POSTGRES_USER=baito
POSTGRES_PASSWORD=
POSTGRES_DB=baito

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─── Object storage ─────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BUCKET_NAME=baito-bucket
# Backups live in their own bucket so a media-bucket policy can never expose them.
BACKUP_BUCKET_NAME=baito-backups

# ─── Networking ─────────────────────────────────────────────────────────────
# Comma-separated. Leave blank to use the built-in list.
CORS_ORIGINS=
# Host interface the frontend binds to. Keep 127.0.0.1 and put a TLS
# terminator (Tailscale Serve, Caddy, nginx) in front of it.
FRONTEND_BIND=127.0.0.1

# ─── SMS gateway (textup.uz) ────────────────────────────────────────────────
TEXTUP_EMAIL=
TEXTUP_PASSWORD=

# ─── Payments (Uzum) ────────────────────────────────────────────────────────
# Leave blank until real credentials exist: the top-up endpoint then returns
# 503 instead of handing users a checkout link that goes nowhere.
UZUM_TERMINAL_ID=
UZUM_SECRET_KEY=
UZUM_API_URL=https://api.uzum.uz/epos/v1

# ─── Backup bot (Telegram) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# ─── Email (payout invoices) ────────────────────────────────────────────────
# Sends the invoice a company receives after a shift has been paid out.
# Without SMTP_HOST and SMTP_FROM the send is refused outright rather than
# reported as sent — an invoice that never left the building, marked delivered,
# would mean a company is never billed and nobody finds out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ─── AI & Translations ──────────────────────────────────────────────────────
# Official Google Gemini API Key for automatic 3-language job announcement translation.
# When provided, replaces cookie-based fallback with official Google Generative AI API.
GEMINI_API_KEY=

# ─── Monitoring ─────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Development only ───────────────────────────────────────────────────────
# Refused in production. Seeds demo accounts with randomly generated passwords
# printed once to the log.
SEED_DEMO_DATA=false
